#!/usr/bin/env bash
# Enforces the sole-contributor policy and Conventional Commits.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | head -n1)

if grep -qiE '^co-authored-by:|generated with \[?claude|noreply@anthropic\.com' "$msg_file"; then
  echo "commit-msg: co-author / AI attribution trailers are not allowed (sole-contributor policy)." >&2
  exit 1
fi

# Allow git-generated merge/revert/fixup subjects.
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
if ! [[ "$subject" =~ $pattern ]]; then
  echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(import): parse OFX files'." >&2
  echo "  got: $subject" >&2
  exit 1
fi
