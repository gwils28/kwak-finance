# Copy to .env and change every value. .env is git-ignored.
POSTGRES_USER=kwak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kwak
KWAK_DATABASE_URL=postgresql+psycopg://kwak:change-me@db:5432/kwak
# Hostname served by Caddy (localhost gets an internal TLS certificate)
KWAK_HOST=localhost
KWAK_ENV=prod
KWAK_SECRET_KEY=
